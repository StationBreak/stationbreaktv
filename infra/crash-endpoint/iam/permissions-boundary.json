{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteReportsOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::stationbreak-crash-reports-<ACCOUNT_ID>-<REGION>/reports/*"
    },
    {
      "Sid": "LogToItsOwnGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:<REGION>:<ACCOUNT_ID>:log-group:/aws/lambda/stationbreak-crash-endpoint:*"
    }
  ]
}

  The copy for the live channel screen (spec 14): the cable banner and Stan's station screens. The strings that spec
  14's global constraints give word for word are exact; the others are the mockups' own wording.
-->
<resources>

    <!--
      Stan's station screens (DESIGN.md, Station Screen). Each is one line for Stan in capitals (two lines are one string
      with a line break), a plain status in the teletype, and a detail. The joke never carries the information; the
      spoken line is the plain status, announced once. We, never I.
    -->
    <string name="live_stan_standby_headline">PLEASE\nSTAND BY</string>
    <string name="live_stan_tuning_status">TUNING CHANNEL %1$d</string>
    <string name="live_stan_building_status">BUILDING YOUR CHANNELS</string>
    <string name="live_stan_starting_status">WARMING UP</string>
    <string name="live_stan_programme">%1$s</string>
    <string name="live_stan_offair_headline">GONE TO BED</string>
    <string name="live_stan_offair_status">OFF THE AIR</string>
    <string name="live_stan_offair_next">BACK WITH THE NEXT PROGRAMME</string>
    <string name="live_stan_offair_returns">%1$s RETURNS AT %2$s</string>
    <string name="live_stan_offair_now_on">NOW ON %1$d</string>
    <string name="live_stan_trouble_headline">WELL, THAT\'S\nNOT RIGHT</string>
    <string name="live_stan_trouble_status">TECHNICAL DIFFICULTIES</string>
    <string name="live_stan_trouble_detail">PLAYING SOMETHING ELSE SHORTLY</string>
    <string name="live_stan_sign_off" translatable="false">Station Break</string>
    <string name="live_stan_spoken_offair">Off the air.</string>
    <string name="live_stan_spoken_offair_next">Off the air. Back with the next programme.</string>
    <string name="live_stan_spoken_offair_returns">Off the air. %1$s returns at %2$s.</string>
    <string name="live_stan_spoken_offair_now_on">%1$s is off the air. Now on %2$d.</string>
    <string name="live_stan_spoken_trouble_status">Technical difficulties.</string>
    <string name="live_stan_spoken_building">Please stand by. Building your channels.</string>
    <string name="live_stan_spoken_starting">Please stand by. Warming up.</string>
    <string name="live_stan_spoken_trouble">Technical difficulties. Playing something else shortly.</string>

    <!-- Signed in, but no channel is on the air: the detail is the keys to where channels are switched on (Back for the guide, then Menu, Channels). -->
    <string name="live_stan_no_channels_headline">NOTHING ON\nTHE AIR</string>
    <string name="live_stan_no_channels_status">NO CHANNELS YET</string>
    <string name="live_stan_no_channels_detail">BACK, THEN MENU › CHANNELS</string>
    <string name="live_stan_spoken_no_channels">No channels on the air yet. Press Back for the guide, then Menu, then Channels.</string>
    <!-- Every library this TV chose is gone from the server (spec 26): the detail is the keys to where to choose them again (Back for the guide, then Menu, Settings, Libraries). -->
    <string name="live_stan_no_libraries_headline">NOTHING ON\nTHE SHELF</string>
    <string name="live_stan_no_libraries_status">NO LIBRARIES</string>
    <string name="live_stan_no_libraries_detail">BACK, THEN MENU › SETTINGS › LIBRARIES</string>
    <string name="live_stan_spoken_no_libraries">No libraries available. Press Back for the guide, then Menu, then Settings, then Libraries.</string>

    <!-- The banner's label line. -->
    <string name="live_label_tuning_in">Tuning in</string>
    <string name="live_label_now">Now</string>
    <string name="live_label_up_next">Up next</string>
    <string name="live_label_filling_in">Programme change</string>
    <string name="live_label_switching_audio">Switching audio</string>
    <string name="live_label_switching_subtitles">Switching subtitles</string>
    <string name="live_label_switching_version">Switching version</string>

    <!-- The label along the top of the picture while the guide is open (#722): the word before what is on. -->
    <string name="live_picture_now_playing">Now playing:</string>
    <string name="live_picture_tuning_in">Tuning in:</string>
    <string name="live_picture_up_next">Up next:</string>
    <string name="live_picture_filling_in">Programme change:</string>
    <string name="live_picture_switching_audio">Switching audio:</string>
    <string name="live_picture_switching_subtitles">Switching subtitles:</string>
    <string name="live_picture_switching_version">Switching version:</string>

    <!-- The actions banner's buttons (Select on the picture): the program's info, and the channel before this one. -->
    <string name="live_action_info">Info</string>
    <string name="live_action_last">Last</string>

    <!-- The Live button of the actions banner, shown while the viewer is paused or behind live: back to the live picture. -->
    <string name="live_action_live">Live</string>

    <!-- DESIGN(#383): placeholder. The transport strip: paused, or how far behind live (a plural, for locales that need one). -->
    <string name="live_transport_paused">Paused</string>
    <string name="live_transport_seeking">Seeking</string>
    <plurals name="live_transport_behind">
        <item quantity="one">%1$d min behind</item>
        <item quantity="other">%1$d min behind</item>
    </plurals>

    <!-- What TalkBack speaks for the banner: "07 Test Channel, Test Movie, 12 minutes left". -->
    <string name="live_spoken_channel">%1$s %2$s</string>
    <string name="live_spoken_program">%1$s, %2$s</string>
    <plurals name="live_spoken_minutes_left">
        <item quantity="one">%1$s, %2$d minute left</item>
        <item quantity="other">%1$s, %2$d minutes left</item>
    </plurals>
    <!-- The title TalkBack gives the Select banner's row of buttons. -->
    <string name="live_actions_pane">Channel actions</string>

    <!-- How far in the viewer joined, on the tune banner: "12 min in", or "Just started" under a minute. -->
    <string name="live_just_started">Just started</string>
    <string name="live_min_in">%1$d min in</string>

    <!-- "Converting for this TV": the Select banner's label at the right end of the chips row while the server re-encodes; no word for direct play or direct stream. -->
    <string name="live_stream_transcoding">Converting for this TV</string>
    <string name="live_stream_subtitles_off">Subtitles off</string>
    <string name="live_stream_subtitles_none">No subtitles</string>
    <string name="live_stream_subtitles">Subtitles %1$s</string>

    <!-- The words of the audio, subtitle and version rows (design doc B2.8). -->
    <string name="live_track_unknown">Unknown</string>
    <string name="live_track_commentary">Commentary</string>
    <string name="live_track_sdh">With sound descriptions</string>
    <string name="live_track_forced">Foreign parts only</string>
    <string name="live_track_text">Text</string>
    <string name="live_track_picture">Picture</string>
    <string name="live_track_off">Off</string>

    <!-- The chips on the Select banner and the pickers they open (design doc B2.4, B2.7, B2.8) -->
    <string name="live_chip_audio">Audio</string>
    <string name="live_chip_subtitles">Subtitles</string>
    <string name="live_chip_version">Version</string>
    <string name="live_chip_none">None</string>
    <string name="live_chip_description">%1$s: %2$s</string>
    <!-- A chip after a switch that did not take, read as: Audio, couldn't switch, still English 5.1 -->
    <string name="live_chip_description_failed">%1$s, couldn\'t switch, still %2$s</string>
    <string name="live_picker_restarts">brief pause</string>
    <string name="live_picker_server_default">Server default</string>
    <string name="live_picker_playing">playing now</string>
    <string name="live_picker_row_description">%1$s, %2$s</string>
    <string name="live_switch_failed">Couldn\'t switch</string>
</resources>

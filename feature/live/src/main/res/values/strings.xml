<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-or-later WITH AdditionRef-StationBreak-AppStore

  The copy for the live channel screen (spec 14): the cable banner and the test-card slates. The strings that spec
  14's global constraints give word for word are exact; the others are the mockups' own wording.
-->
<resources>
    <!-- The test-card slate for a show that is missing or will not play. -->
    <string name="live_difficulties_title">TECHNICAL DIFFICULTIES</string>
    <string name="live_difficulties_standby">PLEASE STAND BY</string>

    <!-- The StationBreak ident card: the app icon's wordmark, on two lines. -->
    <string name="live_ident_station" translatable="false">STATION</string>
    <string name="live_ident_break" translatable="false">BREAK</string>
    <!-- DESIGN(#633): placeholder. The ident card's line when the programme on now left the library and nothing fills the slot. -->
    <string name="live_card_not_in_library">No longer in the library. Back with the next programme.</string>
    <string name="live_no_channels">No channels on the air yet</string>
    <!-- placeholder: design partner. Every library this TV chose is gone from the server (spec 26). -->
    <string name="live_no_libraries">No libraries available. Guide, Settings, Libraries.</string>

    <!-- The banner's label line. -->
    <string name="live_label_tuning_in">Tuning in</string>
    <string name="live_label_now">Now</string>
    <string name="live_label_up_next">Up next</string>
    <string name="live_label_filling_in">Filling in</string>
    <string name="live_label_switching_audio">Switching audio</string>
    <string name="live_label_switching_subtitles">Switching subtitles</string>

    <!-- The actions banner's buttons (Select on the picture): the program's info, and the channel before this one. -->
    <string name="live_action_info">Info</string>
    <string name="live_action_last">Last</string>

    <!-- The Live button of the actions banner, shown while the viewer is paused or behind live: back to the live picture. -->
    <string name="live_action_live">Live</string>

    <!-- DESIGN(#383): placeholder. The transport strip: paused, or how far behind live (a plural, for locales that need one). -->
    <string name="live_transport_paused">Paused</string>
    <string name="live_transport_seeking">Seeking</string>
    <plurals name="live_transport_behind">
        <item quantity="one">%1$d min behind</item>
        <item quantity="other">%1$d min behind</item>
    </plurals>

    <!-- How far in the viewer joined, on the tune banner: "12 min in", or "Just started" under a minute. -->
    <string name="live_just_started">Just started</string>
    <string name="live_min_in">%1$d min in</string>

    <!-- "Transcoding": the Select banner's label at the right end of the chips row while the server re-encodes; no word for direct play or direct stream. -->
    <string name="live_stream_transcoding">Transcoding</string>
    <string name="live_stream_subtitles_off">Subtitles off</string>
    <string name="live_stream_subtitles_none">No subtitles</string>
    <string name="live_stream_subtitles">Subtitles %1$s</string>

    <!-- The words of the audio, subtitle and version rows (design doc B2.8). -->
    <string name="live_track_unknown">Unknown</string>
    <string name="live_track_commentary">Commentary</string>
    <string name="live_track_sdh">SDH</string>
    <string name="live_track_forced">Forced</string>
    <string name="live_track_text">Text</string>
    <string name="live_track_picture">Picture</string>
    <string name="live_track_off">Off</string>

    <!-- The chips on the Select banner and the pickers they open (design doc B2.4, B2.7, B2.8) -->
    <string name="live_chip_audio">Audio</string>
    <string name="live_chip_subtitles">Subtitles</string>
    <string name="live_chip_version">Version</string>
    <string name="live_chip_none">None</string>
    <string name="live_chip_description">%1$s: %2$s</string>
    <string name="live_picker_restarts">brief pause</string>
    <string name="live_picker_server_default">Server default</string>
    <string name="live_picker_playing">playing now</string>
    <string name="live_picker_row_description">%1$s, %2$s</string>
    <string name="live_switch_failed">Couldn\'t switch</string>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-or-later WITH AdditionRef-StationBreak-AppStore

  The copy for the live channel screen (spec 14): the cable banner and the test-card slates. The strings that spec
  14's global constraints give word for word are exact; the others are the mockups' own wording.
-->
<resources>
    <!-- The test-card slate for a show that is missing or will not play. -->
    <string name="live_difficulties_title">TECHNICAL DIFFICULTIES</string>
    <string name="live_difficulties_standby">PLEASE STAND BY</string>

    <!-- The StationBreak ident card: the app icon's wordmark, on two lines. -->
    <string name="live_ident_station" translatable="false">STATION</string>
    <string name="live_ident_break" translatable="false">BREAK</string>
    <string name="live_no_channels">No channels on the air yet</string>

    <!-- The banner's label line. -->
    <string name="live_label_tuning_in">Tuning in</string>
    <string name="live_label_now">Now</string>
    <string name="live_label_up_next">Up next</string>
    <string name="live_label_filling_in">Filling in</string>

    <!-- The actions banner's buttons (Select on the picture): the program's info, and the channel before this one. -->
    <string name="live_action_info">Info</string>
    <string name="live_action_last">Last</string>

    <!-- The Live button of the actions banner, shown while the viewer is paused or behind live: back to the live picture. -->
    <string name="live_action_live">Live</string>

    <!-- DESIGN(#383): placeholder. The transport strip: paused, or how far behind live (a plural, for locales that need one). -->
    <string name="live_transport_paused">Paused</string>
    <string name="live_transport_seeking">Seeking</string>
    <plurals name="live_transport_behind">
        <item quantity="one">%1$d min behind</item>
        <item quantity="other">%1$d min behind</item>
    </plurals>

    <!-- How far in the viewer joined; "Just started" under a minute. -->
    <string name="live_just_started">Just started</string>
    <string name="live_joining">joining %1$d min in</string>
</resources>

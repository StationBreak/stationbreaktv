<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-or-later WITH AdditionRef-StationBreak-AppStore

  The copy for the program guide (spec 17). The program words it shares with the banner (episode lines, "Off air
  until", countdowns) are in core:ui.
-->
<resources>
    <!-- While the schedule is being built, and when there is nothing to show. -->
    <string name="guide_loading">Loading the guide…</string>
    <string name="guide_empty">Nothing on the guide yet</string>
    <!-- placeholder: design partner. Every library this TV chose is gone from the server (spec 26). -->
    <string name="guide_no_libraries">None of this TV\'s libraries are available. Choose them in Settings, Libraries.</string>

    <!-- The tags under the details panel's meta line (#723). SD, HD, 4K, 5.1 and 7.1 are the same in every language. -->
    <string name="guide_tag_mono">Mono</string>
    <string name="guide_tag_stereo">Stereo</string>
    <string name="guide_tag_cc">CC</string>
    <string name="guide_tag_critics">Critics</string>
    <string name="guide_tag_audience">Audience</string>

    <!-- The hint row: a key name, then what it does. OK tunes what is on now, and the channel of a later program. -->
    <string name="guide_key_ok">OK</string>
    <string name="guide_key_back">Back</string>
    <string name="guide_hint_watch">Watch</string>
    <string name="guide_hint_watch_channel">Watch channel</string>
    <!-- On the channel column (#631): OK opens the channel's properties, Right or Back returns to the programs. -->
    <string name="guide_key_right">▸</string>
    <string name="guide_hint_properties">About this channel</string>
    <string name="guide_hint_programs">Back to programs</string>
    <string name="guide_hint_exit">Exit live TV</string>
    <!-- Back while the focus is away from the channel playing: it goes back to what is on now there. -->
    <string name="guide_hint_playing">To what\'s playing</string>

    <!-- Back on the playing channel's cell: it opens the menu sheet. -->
    <string name="guide_hint_menu">To the menu</string>
    <!-- The Menu key (#756) opens the menu sheet from anywhere in the guide; in the sheet, Back and Menu close it. -->
    <string name="guide_key_menu">Menu</string>
    <string name="guide_hint_open_menu">Open the menu</string>
    <string name="guide_hint_close_menu">Close the menu</string>

    <!-- The details panel while the focus is on the channel column (#631): the line over the channel's name. -->
    <string name="guide_channel_number">Channel %1$d</string>

    <!-- The rows of the menu sheet (#756): the first opens channel management (spec 21), the second leaves. -->
    <string name="guide_channels_button">Channels</string>
    <string name="guide_settings_button">Settings</string>
    <string name="guide_settings_appearance">Appearance</string>
    <string name="guide_theme_dark">Dark</string>
    <string name="guide_theme_light">Light</string>
    <!-- placeholder: design partner. The Settings panel's screen fit: Safe keeps text 5% in from every edge, Edge 1.5%. -->
    <string name="guide_settings_screen_fit">Screen fit</string>
    <string name="guide_fit_safe">Safe</string>
    <string name="guide_fit_edge">Edge</string>
    <!-- INTERIM copy, pending the design pass (#498). The Settings panel's volume levelling row. Its summary ("Keeps
         quiet and loud shows at a similar level") is left out until the panel has room for one line under each row. -->
    <string name="guide_settings_levelling">Even out volume</string>
    <string name="guide_levelling_off">Off</string>
    <string name="guide_levelling_on">On</string>
    <!-- placeholder: design partner. The Settings panel's row that opens Settings, Libraries (spec 26). -->
    <string name="guide_settings_libraries">Libraries</string>
    <!-- placeholder: design partner. The Settings panel's row that syncs with the server now (spec 26), and the line
         beside it: running, done (the time in the device's own format), or why it failed. -->
    <string name="guide_settings_sync_now">Sync now</string>
    <string name="guide_sync_running">Syncing…</string>
    <string name="guide_sync_done">Synced at %1$s</string>
    <string name="guide_sync_failed_network">Couldn\'t reach the server. Nothing changed.</string>
    <string name="guide_sync_failed_session">Sign-in expired. Nothing changed.</string>
    <string name="guide_sync_failed_server">The server had a problem. Nothing changed.</string>
    <string name="guide_sync_failed_suspect">The server\'s answer looked wrong. Nothing changed.</string>
    <!-- placeholder: design partner. The same reasons when the sync itself failed, after it may have written some of
         the server's changes: the reason alone. -->
    <string name="guide_sync_reason_network">Couldn\'t reach the server.</string>
    <string name="guide_sync_reason_session">Sign-in expired.</string>
    <string name="guide_sync_reason_server">The server had a problem.</string>
    <string name="guide_sync_reason_suspect">The server\'s answer looked wrong.</string>
    <string name="guide_exit_button">Exit</string>

    <!-- The chip in front of the slot of a program on now. -->
    <string name="guide_now">Now</string>

    <!-- A slate cell on the grid: a plate, not a missing title. The panel still says when it comes back. -->
    <string name="guide_off_air">Off air</string>

    <!-- DESIGN(#633): placeholder. A program whose item left the library: the cell's title and the panel's line, instead of a blank. -->
    <string name="guide_unavailable">Unavailable</string>

    <!-- What a screen reader says about a cell: its title and slot, then "on now" for the program airing. -->
    <string name="guide_cell_description">%1$s, %2$s</string>
    <string name="guide_cell_on_now">%1$s, on now</string>

    <!-- The meta line under the title in the panel: runtime, then it is joined with the year and genres. -->
    <string name="guide_runtime_minutes">%1$d min</string>
    <string name="guide_runtime_hours_minutes">%1$d h %2$d min</string>
    <string name="guide_runtime_hours">%1$d h</string>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-or-later WITH AdditionRef-StationBreak-AppStore

  The copy for the program guide (spec 17). The program words it shares with the banner (episode lines, "Off air
  until", countdowns) are in core:ui.
-->
<resources>
    <!-- While the schedule is being built, and when there is nothing to show. -->
    <string name="guide_loading">Getting the listings…</string>
    <string name="guide_empty">Nothing on the guide yet</string>
    <!-- placeholder: design partner. Every library this TV chose is gone from the server (spec 26). -->
    <string name="guide_no_libraries">None of this TV\'s libraries are available. Choose them in Settings, Libraries.</string>

    <!-- The tags under the details panel's meta line (#723). SD, HD, 4K, 5.1 and 7.1 are the same in every language. -->
    <string name="guide_tag_mono">Mono</string>
    <string name="guide_tag_stereo">Stereo</string>
    <string name="guide_tag_cc">CC</string>
    <string name="guide_tag_critics">Critics</string>
    <string name="guide_tag_audience">Audience</string>

    <!-- The hint row: a key name (OK and Back are core:ui's), then what it does. OK tunes what is on now, and the
         channel of a later program. -->
    <string name="guide_hint_watch">Watch</string>
    <string name="guide_hint_watch_channel">Watch channel</string>
    <!-- On the channel column (#631): OK opens the channel's properties, Right or Back returns to the programs. -->
    <string name="guide_key_right">▸</string>
    <string name="guide_hint_properties">About this channel</string>
    <string name="guide_hint_programs">Back to programmes</string>
    <string name="guide_hint_exit">Exit live TV</string>
    <!-- Back while the focus is away from the channel playing: it goes back to what is on now there. -->
    <string name="guide_hint_playing">To what\'s playing</string>

    <!-- The Menu key (#756) opens the menu sheet from anywhere in the guide; in the sheet, Back and Menu close it. -->
    <string name="guide_key_menu">Menu</string>
    <!-- What opens the menu sheet: the Menu key, and Back on the playing channel's cell (the hint says it once). -->
    <string name="guide_hint_open_menu">Open the menu</string>
    <string name="guide_hint_close_menu">Close the menu</string>

    <!-- The details panel while the focus is on the channel column (#631): the line over the channel's name. -->
    <string name="guide_channel_number">Channel %1$d</string>

    <!-- Left from the first cell of a row goes to the channel column (#803): the key cap is an arrow, the label is the
         properties hint's own words. -->
    <string name="guide_key_left">◂</string>

    <!-- The menu sheet's first row (#803), while the guide shows a grid: opens the focused channel's properties. -->
    <string name="guide_menu_about">About %1$s</string>

    <!-- The rows of the menu sheet (#756): Channels opens channel management (spec 21), Settings the Settings sheet, and
         Exit leaves. -->
    <string name="guide_channels_button">Channels</string>
    <string name="guide_settings_button">Settings</string>
    <!-- The Settings sheet (#336): its section flags, drawn in the teletype's capitals and read as written. -->
    <string name="guide_settings_group_picture">Picture</string>
    <string name="guide_settings_group_playback">Playback</string>
    <string name="guide_settings_group_library">Library</string>
    <string name="guide_settings_group_account">Account</string>
    <!-- A choice row as a screen reader hears it while it has the focus: its label, then its value. -->
    <string name="guide_settings_spoken">%1$s, %2$s</string>
    <!-- The end of a row that opens another screen. -->
    <string name="guide_settings_chevron">›</string>
    <string name="guide_settings_appearance">Appearance</string>
    <string name="guide_theme_dark">Dark</string>
    <string name="guide_theme_light">Light</string>
    <!-- placeholder: design partner. The Settings sheet's screen fit: Safe keeps text 5% in from every edge, Edge 1.5%. -->
    <string name="guide_settings_screen_fit">Screen fit</string>
    <string name="guide_fit_safe">Safe</string>
    <string name="guide_fit_edge">Edge</string>
    <!-- What live TV shows while the channel changes, named by what the viewer sees: Stan's stand-by card (the
         default) or the old static. -->
    <string name="guide_settings_channel_change">When changing channel</string>
    <string name="guide_channel_change_card">Stand-by card</string>
    <string name="guide_channel_change_static">Static</string>
    <!-- The Settings sheet's volume levelling row (#498). -->
    <string name="guide_settings_levelling">Even out volume</string>
    <string name="guide_levelling_off">Off</string>
    <string name="guide_levelling_on">On</string>
    <!-- placeholder: design partner. The Settings sheet's row that opens Settings, Libraries (spec 26). -->
    <string name="guide_settings_libraries">Libraries</string>
    <!-- placeholder: design partner. The Settings sheet's row that updates the library now (spec 26), and the line
         under it: running, done (the time in the device's own format), or why it failed. -->
    <string name="guide_settings_sync_now">Update library</string>
    <string name="guide_sync_running">Updating…</string>
    <string name="guide_sync_done">Updated at %1$s</string>
    <string name="guide_sync_failed_network">Couldn\'t reach the server. Nothing changed.</string>
    <string name="guide_sync_failed_session">Sign-in expired. Nothing changed.</string>
    <string name="guide_sync_failed_server">The server had a problem. Nothing changed.</string>
    <string name="guide_sync_failed_suspect">The server sent something StationBreak couldn\'t read. Nothing changed.</string>
    <!-- placeholder: design partner. Every chosen library is gone from the server (#507): choosing again is the way out. -->
    <string name="guide_sync_failed_libraries_gone">This TV\'s libraries are gone from the server. Choose them in Libraries. Nothing changed.</string>
    <!-- placeholder: design partner. The same reasons when the sync itself failed, after it may have written some of
         the server's changes: the reason alone. -->
    <string name="guide_sync_reason_network">Couldn\'t reach the server.</string>
    <string name="guide_sync_reason_session">Sign-in expired.</string>
    <string name="guide_sync_reason_server">The server had a problem.</string>
    <string name="guide_sync_reason_suspect">The server sent something StationBreak couldn\'t read.</string>
    <string name="guide_sync_reason_libraries_gone">This TV\'s libraries are gone from the server. Choose them in Libraries.</string>
    <!-- The Settings sheet's last row (#336): OK asks whether to sign out of this TV. -->
    <string name="guide_settings_sign_out">Sign out</string>
    <!-- The Settings sheet's hint row (its keys and Close are core:ui's): Left and Right change a choice, OK moves it
         on to the next value, opens a link, updates the library on Update library, or signs out on Sign out (the row's
         own words); Back closes the sheet. -->
    <string name="guide_hint_change">Change</string>
    <string name="guide_hint_next">Next</string>
    <string name="guide_hint_open">Open</string>
    <string name="guide_hint_update">Update</string>
    <string name="guide_exit_button">Exit</string>

    <!-- The chip in front of the slot of a program on now. -->
    <string name="guide_now">Now</string>

    <!-- A slate cell on the grid: a plate, not a missing title. The panel still says when it comes back. -->
    <string name="guide_off_air">Off air</string>

    <!-- A station-break cell on the grid (leftover time spread through the day): a plate in the slate's style. The panel says what is up next. -->
    <string name="guide_station_break">Station break</string>
    <!-- After the title written once over a run of short programmes of one title (shorts, cartoons, music videos): how many programmes the run holds, as in "Big Buck Bunny · 12". The leading space separates it from the title. Drawn only; a screen reader hears each programme's own cell. -->
    <string name="guide_run_count">" · %1$d"</string>
    <!-- The brand name beside Stan's head on the panel's top line; decorative, never read out. -->
    <string name="guide_station_bug" translatable="false">Station Break</string>
    <!-- The meta line of a focused station break in the panel: the title of the program that follows it and its start time. -->
    <string name="guide_up_next_title_at">Up next: %1$s at %2$s</string>
    <!-- The same line when the program that follows has no title (it left the library), or nothing follows: the time alone. -->
    <string name="guide_up_next_at">Up next at %1$s</string>

    <!-- The channel box's line about what a channel airs now (#777), before the minutes left and what is next. -->
    <string name="guide_channel_on_now">On now: %1$s</string>

    <!-- DESIGN(#633): placeholder. A program whose item left the library: the cell's title and the panel's line, instead of a blank. -->
    <string name="guide_unavailable">Removed</string>

    <!-- What a screen reader says about a cell: its title and slot, then "on now" for the program airing. -->
    <string name="guide_cell_description">%1$s, %2$s</string>
    <string name="guide_cell_on_now">%1$s, on now</string>
    <!-- Added to a cell of the channel that live TV is playing, after "on now". -->
    <string name="guide_cell_playing">%1$s, playing</string>
    <!-- The state a screen reader gives the playing channel's tile, and the panel's channel line says. -->
    <string name="guide_playing">Playing</string>
    <!-- The first visit's note, in the info panel's place until the first key press (#94). Setup's cheer has just said
         "on the air", so the note does not say it again. A title with no closing mark, as the panel's titles have. -->
    <string name="first_visit_title">Here are your channels</string>
    <string name="first_visit_body">Choose one to watch, or press OK to keep watching this one.</string>

    <!-- The meta line under the title in the panel: runtime, then it is joined with the year and genres. -->
    <string name="guide_runtime_minutes">%1$d min</string>
    <string name="guide_runtime_hours_minutes">%1$d h %2$d min</string>
    <string name="guide_runtime_hours">%1$d h</string>
</resources>

  The copy table for onboarding (spec 05, "Wording process"). Every word on these screens is a DRAFT: the lead reviews
  it with Adorabelle before the owner sees it on the device. Errors follow decision 5: a plain sentence, a small
  details line naming the technical cause, and one next step.
-->
<resources>
    <!-- The server screen. One headline, no welcome screen (decision 8). -->
    <string name="server_headline">Connect to your Jellyfin server</string>
    <string name="server_address_label">Server address</string>
    <string name="server_address_hint">For example, jellyfin.local:8096</string>
    <string name="server_test">Test</string>
    <string name="server_testing">Testing…</string>
    <string name="server_cancel">Cancel</string>
    <string name="server_continue">Continue</string>
    <string name="server_retry">Retry</string>
    <string name="server_edit_address">Edit address</string>

    <!-- A successful Test. -->
    <string name="server_connected_name">Found %1$s</string>
    <string name="server_connected_version">Jellyfin version %1$s</string>

    <!-- After the user accepted an unencrypted connection (ADR-0014): the success panel keeps saying so. -->
    <string name="server_connected_cleartext">Not encrypted (http)</string>

    <!-- Accessibility: the icon beside an error says "Problem" so colour is never the only signal. -->
    <string name="server_problem_icon">Problem</string>

    <!-- The cleartext confirmation (ADR-0014). Cancel has default focus. -->
    <string name="cleartext_title">Connect without encryption?</string>
    <string name="cleartext_body_public">This address uses http, so nothing sent to it is encrypted. Anyone on the network between this TV and the server could read your password.</string>
    <string name="cleartext_body_fallback">StationBreak couldn’t connect securely, so it tried http. If you continue, anyone on the network between this TV and the server could read your password.</string>
    <string name="cleartext_cancel">Cancel</string>
    <string name="cleartext_continue">Connect anyway</string>

    <!-- Error table: network. Each error has a message, then a details line. -->
    <string name="error_dns_message">This TV can’t find a server with that name. Check the spelling, or try the server’s IP address.</string>
    <string name="error_dns_details">Name lookup failed</string>
    <string name="error_refused_message">Nothing is accepting connections at that address. Check the port, and that Jellyfin is running.</string>
    <string name="error_refused_details">Connection refused</string>
    <string name="error_unreachable_message">This TV can’t reach the network. Check its Wi-Fi or Ethernet connection.</string>
    <string name="error_unreachable_details">Network unreachable</string>
    <string name="error_timeout_message">The server didn’t answer in time. Check that it is turned on and on the same network.</string>
    <string name="error_timeout_details">Timed out</string>

    <!-- Error table: the server answered but is not a usable Jellyfin. -->
    <string name="error_not_jellyfin_message">Something answered, but it doesn’t look like Jellyfin. Check the address and the port.</string>
    <string name="error_not_jellyfin_details">Not a Jellyfin server</string>
    <string name="error_unsupported_version_message">This Jellyfin server is version %1$s. StationBreak needs %2$s or newer, so the server needs updating.</string>
    <string name="error_unsupported_version_details">Server version too old</string>
    <string name="error_not_set_up_message">This Jellyfin server hasn’t finished its first-time setup. Finish setup in a web browser, then try again.</string>
    <string name="error_not_set_up_details">Server setup not finished</string>
    <string name="error_redirected_message">The server sent StationBreak to another address. Enter the address you use in a web browser.</string>
    <string name="error_redirected_details">Redirect not followed</string>
    <string name="error_server_error_message">The server reported a problem. Wait a moment, then try again.</string>
    <string name="error_server_error_details">Server error</string>
    <string name="error_not_found_message">The server answered, but not with what StationBreak expected. Check the address.</string>
    <string name="error_not_found_details">Not found</string>
    <string name="error_unknown_message">Something unexpected went wrong.</string>
    <string name="error_unknown_details">Unknown error</string>

    <!-- A blank field: nothing was sent, so this is not a Jellyfin error. -->
    <string name="server_blank_message">Type your server’s address, then choose Test.</string>
    <string name="server_blank_details">Address is empty</string>

    <!-- Error table: the address. -->
    <string name="error_invalid_address_message">That doesn’t look like a server address. Use a name or an IP address, with a port if the server needs one.</string>
    <string name="error_invalid_address_details">Address not valid</string>

    <!-- Error table: TLS. A dead end: a self-signed certificate gets the trust screen instead, so no trust option is offered here. -->
    <string name="error_tls_untrusted_message">This TV doesn’t trust the server’s security certificate.</string>
    <string name="error_tls_untrusted_details">Certificate not trusted</string>
    <string name="error_tls_hostname_message">The server’s security certificate is for a different name than the one you typed.</string>
    <string name="error_tls_hostname_details">Certificate name mismatch</string>
    <string name="error_tls_expired_message">The server’s security certificate has expired, or this TV’s date and time are wrong. Renew the certificate on the server, or check the TV’s date and time.</string>
    <string name="error_tls_expired_details">Certificate expired</string>
    <string name="error_tls_not_yet_valid_message">The server’s security certificate isn’t valid yet. Check this TV’s date and time, and the server’s.</string>
    <string name="error_tls_not_yet_valid_details">Certificate not yet valid</string>
    <string name="error_tls_changed_message">The server’s security certificate is different from the one this TV trusted before, and it can’t be verified. Check the certificate on the server.</string>
    <string name="error_tls_changed_details">Certificate changed</string>
    <string name="error_tls_handshake_message">This TV could not set up a secure connection. The server may use security settings this TV can’t use.</string>
    <string name="error_tls_handshake_details">Secure connection failed</string>
    <string name="error_not_tls_message">That address starts with https, but the server isn’t using encryption on that port. Check the port.</string>
    <string name="error_not_tls_details">Server did not speak TLS</string>

    <!-- Error table: errors that sign-in and restore produce. They are not expected from a Test, but every error has copy. -->
    <string name="error_unauthorized_message">Wrong username or password. Check both, then sign in.</string>
    <string name="error_unauthorized_details">Unauthorized</string>
    <string name="error_forbidden_message">The server refused this sign-in. Ask whoever runs it to check that this account and this TV are allowed.</string>
    <string name="error_forbidden_details">Forbidden</string>
    <string name="error_cleartext_message">This address needs your confirmation before connecting without encryption.</string>
    <string name="error_cleartext_details">Unencrypted connection not confirmed</string>
    <string name="error_session_expired_message">The server no longer accepts this sign-in.</string>
    <string name="error_session_expired_details">Session expired</string>
    <string name="error_server_mismatch_message">The server at this address is not the one you signed in to before.</string>
    <string name="error_server_mismatch_details">Server changed</string>
    <string name="error_quick_connect_message">Quick Connect is turned off on this server. Sign in with your username and password instead.</string>
    <string name="error_quick_connect_details">Quick Connect disabled</string>

    <!-- Sign-in and Quick Connect (spec 05, Unit 2). One sign-in: the account is the app's user, admin or not (decision 9). -->
    <string name="signin_headline">Sign in to %1$s</string>
    <string name="signin_username">Username</string>
    <string name="signin_password">Password</string>
    <string name="signin_username_hint">Your Jellyfin username</string>
    <string name="signin_password_hint">Your Jellyfin password</string>
    <string name="signin_show_password">Show</string>
    <string name="signin_hide_password">Hide</string>
    <string name="signin_show_password_description">Show password</string>
    <string name="signin_hide_password_description">Hide password</string>
    <string name="signin_sign_in">Sign in</string>
    <string name="signin_signing_in">Signing in…</string>
    <string name="signin_progress_description">Signing in</string>
    <string name="signin_signed_in">Signed in.</string>
    <string name="signin_quick_connect">Quick Connect</string>
    <string name="signin_blank_username_message">Type your username, then choose Sign in.</string>
    <string name="signin_blank_username_details">Username is empty</string>

    <!-- The Quick Connect screen: the code in large type, approved from a device that is already signed in. -->
    <string name="quick_connect_headline">Sign in with Quick Connect</string>
    <string name="quick_connect_instructions">On another device signed in to this Jellyfin server, open Quick Connect in its settings and enter this code.</string>
    <string name="quick_connect_getting_code">Getting a code…</string>
    <string name="quick_connect_waiting">Waiting for approval…</string>
    <string name="quick_connect_code_description">Quick Connect code %1$s</string>
    <string name="quick_connect_cancel">Cancel</string>
    <string name="quick_connect_expired">The code ran out of time before it was approved. Choose Quick Connect to get a new one.</string>
    <string name="quick_connect_expired_details">Quick Connect code expired</string>
    <string name="quick_connect_denied">The sign-in was declined on the other device. Choose Quick Connect to get a new code.</string>
    <string name="quick_connect_denied_details">Quick Connect declined</string>

    <!-- The trust screen (spec 05, Unit 3, Angua): the warning, then the fingerprint, then the buttons. Don't trust has default focus and is what Back means. -->
    <string name="trust_title">Trust this server’s certificate?</string>
    <string name="trust_title_changed">This server’s certificate has changed</string>
    <string name="trust_warning_untrusted">This TV can’t verify this server’s security certificate. The server signed it itself. Only trust it if you set up this server yourself.</string>
    <string name="trust_warning_hostname">This certificate is for a different name than the address you typed, and the server signed it itself. Only trust it if you set up this server yourself.</string>
    <string name="trust_warning_expired">This certificate expired on %1$s, or this TV’s date and time are wrong. The server signed it itself. Check the TV’s date and time first. Only trust it if you set up this server yourself.</string>
    <string name="trust_warning_not_yet_valid">This certificate isn’t valid until %1$s. If that date has passed, this TV’s date and time are wrong. The server signed it itself. Only trust it if you set up this server yourself.</string>
    <string name="trust_warning_changed">The server’s certificate is different from the one you trusted before. If you didn’t change it, someone may be intercepting the connection. Only trust the new one if you replaced it yourself. You will need to sign in again.</string>
    <string name="trust_fingerprint_label">SPKI SHA-256 fingerprint</string>
    <string name="trust_fingerprint_note">Compare this with your server’s public-key fingerprint. It won’t match the one a browser shows.</string>
    <string name="trust_validity">Valid from %1$s to %2$s</string>
    <string name="trust_dont_trust">Don’t trust</string>
    <string name="trust_trust">Trust this certificate</string>
    <string name="trust_trust_changed">Trust the new certificate</string>
    <string name="trust_server_address">Server: %1$s</string>
    <!-- After Don't trust or Back: the server screen says so, until the next Test or edit. -->
    <string name="server_not_trusted">Not connected. You didn’t trust this server’s certificate.</string>
    <string name="error_trust_not_saved_message">This TV couldn’t save that you trust this certificate, so it didn’t connect. Try again.</string>
    <string name="error_trust_not_saved_details">Settings not saved</string>

    <!-- Prefix of the details line when the technical cause is known. -->
    <string name="error_details_with_cause">%1$s (%2$s)</string>

    <!-- Launch routing (spec 05, Unit 4). A plain progress screen while the stored setup is checked. -->
    <string name="launch_checking">Checking your server…</string>
    <string name="launch_progress_description">Checking your server</string>
    <string name="launch_unavailable_title">Can’t connect to your server</string>
    <string name="launch_change_server">Change server</string>

    <!-- The library picker (S0.5.4). DRAFT wording for Adorabelle. Home videos start unselected (decision 7). -->
    <string name="libraries_headline">Choose your libraries</string>
    <string name="libraries_subtitle">StationBreak will only use the libraries you select.</string>
    <string name="libraries_loading">Loading your libraries…</string>
    <string name="libraries_progress_description">Loading your libraries</string>
    <string name="libraries_done">Done</string>
    <string name="libraries_none_ticked">Select at least one library to continue.</string>
    <string name="libraries_kind_movies">Movies</string>
    <string name="libraries_kind_tv_shows">TV shows</string>
    <string name="libraries_kind_mixed">Mixed content</string>
    <string name="libraries_kind_home_videos">Home videos</string>
    <string name="libraries_kind_music_videos">Music videos</string>
    <string name="libraries_none_message">This server has no libraries StationBreak can use. Add a movie or TV library in Jellyfin, then choose Retry.</string>
    <string name="libraries_none_details">No usable libraries</string>
    <string name="libraries_save_failed_message">Couldn’t save your choice on this TV. Choose Done to try again.</string>
    <string name="libraries_save_failed_details">Settings not saved</string>

    <!-- Back from the library picker: who is signed in. DRAFT wording for Adorabelle. -->
    <string name="signed_in_as">Signed in as %1$s</string>
    <string name="signed_in_to">Signed in to %1$s</string>
    <string name="signed_in_plain">Signed in</string>
    <string name="signed_in_continue">Continue</string>
    <string name="signed_in_switch_user">Switch user</string>
    <string name="signed_in_switching">Signing out…</string>
    <string name="signed_in_progress_description">Signing out</string>

    <!-- The placeholder shown after setup, until the first real screen exists (F1.x). No actions. -->
    <string name="setup_complete_headline">Setup complete</string>
    <string name="setup_complete_body">Your server and libraries are saved. There’s nothing to watch yet, because StationBreak is still being built.</string>

    <!--
      The first-sync progress screen (spec 06, Unit 3; owner answer 3: only for the very first sync, later syncs are
      quiet). DRAFT wording for Adorabelle, who finalises it before the screenshots are taken. A headline, one reassuring
      line, a bar, and a count. Nothing on the screen takes focus while it syncs. On failure the error comes from the
      error table above, with Retry.
    -->
    <string name="first_sync_headline">Getting your library ready</string>
    <string name="first_sync_second_line">This only happens once and can take a few minutes.</string>
    <string name="first_sync_starting">Getting started…</string>
    <string name="first_sync_count">%1$s of %2$s</string>
    <string name="first_sync_count_only">%1$s so far</string>
    <string name="first_sync_progress_description">Getting your library ready: %1$s of %2$s</string>
    <string name="first_sync_progress_description_starting">Getting your library ready</string>
    <string name="first_sync_failed_headline">Your library isn’t ready yet</string>
    <string name="first_sync_waiting_for_network">Waiting for your network…</string>
    <string name="first_sync_sign_in_again">Sign in again</string>
    <!-- Said by TalkBack at each quarter: 25, 50, 75 and 100. -->
    <string name="first_sync_announce">%1$d percent</string>
</resources>

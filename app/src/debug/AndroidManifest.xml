<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Debug builds only: the host activity for the instrumented tests. INTERNET, which those tests and the on-device
        probe (OnDeviceServerProbeTest) also need, comes from the main manifest.
    -->
    <application>
        <!--
            The host for tests that set their own content under Hilt (SignInNavigationTest). Landscape and no
            recreation on orientation or keyboard changes, for the reason in
            feature/onboarding/src/androidTest/AndroidManifest.xml: CI's API 25 emulator starts in portrait, rotates,
            and recreates the host, which loses content set by compose.setContent(). A TV is always landscape.
        -->
        <activity
            android:name=".HiltTestActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
        <!--
            The command that rebuilds today's schedule now (#812), for `adb shell am broadcast -a
            tv.stationbreak.debug.REBUILD_TODAY -p <package>`. Debug and benchmark builds only, and declared in both
            manifests (src/debug and src/benchmark), never in main, so a release build has none. Exported so the shell can
            reach it, and it demands the DUMP permission, which the shell UID holds and an ordinary app cannot get.
            BackupRulesTest checks it is in these two variants and in no other.
        -->
        <receiver
            android:name="tv.stationbreak.app.debugcmd.RebuildTodayReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="tv.stationbreak.debug.REBUILD_TODAY" />
            </intent-filter>
        </receiver>
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The app talks to the user's own Jellyfin server, so it declares INTERNET itself. A library manifest merges it
        into release builds too, but nothing should depend on that.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        WorkManager's manifest adds a foreground-service permission and service that nothing here uses (the sync is
        plain background work, never setForeground). Removed so they are not on the attack surface (Angua L1);
        BackupRulesTest keeps the exact list of permissions and exported components.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- No backup anywhere: allowBackup and fullBackupContent cover API 25-30, dataExtractionRules Android 12+. -->
    <!-- tools:targetApi="31": dataExtractionRules only exists from API 31; without it Lint flags UnusedAttribute. -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name=".StationBreakApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Spec 03, Unit 4 (S0.3.5, R16). Trust is the system store plus the two Let's Encrypt roots bundled in res/raw
  (app/trust-anchors/README.md): Fire OS 6 (API 25) ships ISRG Root X1 but not X2 or Root YE. There is no
  user-installed CA source, no debug-overrides and no pinning.

  The one cleartext permission: the owner's own media server may be plain HTTP on the home network. The cleartext
  gate is in the app (spec 03 Unit 1, cleartextNeedsConfirmation): an http:// address is never used without the
  user's explicit, bound acknowledgement. NetworkSecurityConfigTest allows exactly this one attribute and exactly
  this one lint suppression.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x2" />
            <certificates src="@raw/isrg_root_ye" />
        </trust-anchors>
    </base-config>
</network-security-config>

.gradle/
build/
.kotlin/

# Android
local.properties
captures/

# IDE
.idea/
*.iml

# Signing material and build outputs: never commit these. The CI debug key lives in secrets (ADR-0011, amended).
*.jks
*.keystore
*.p12
keystore.properties
*.apk
*.aab
/dist/
.env*

# SDD working artifacts (questions, spec, tasks, audit, proofs) stay local. Proofs go on the PR; anything
# durable goes in an ADR, BACKLOG.md or the issue (owner decision, 2026-10-12).
/docs/specs/

# Python bytecode
__pycache__/

# The lineup audit exporter's output (tools/audit-export). A snapshot holds titles. It is written outside the repository
# by design; these patterns keep one that was copied in by hand out of a commit.
/audit-snapshots/
audit-snapshot-*.json
/tools/audit-export/out/
stationbreak-audit/

# Claude Code agent worktrees are local scratch checkouts.
/.claude/worktrees/

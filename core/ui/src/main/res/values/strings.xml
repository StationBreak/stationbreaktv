<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-or-later WITH AdditionRef-StationBreak-AppStore

  The program text shared by the live banner and the guide (spec 17): episode lines, next/off-air/countdown words and
  the program info overlay.
-->
<resources>
    <!-- The episode line: season and episode numbers (the ones that are known), then the episode's title. -->
    <string name="program_episode_both">S%1$d E%2$d · %3$s</string>
    <string name="program_episode_season">S%1$d · %2$s</string>
    <string name="program_episode_number">E%1$d · %2$s</string>

    <string name="program_next">Up next: %1$s at %2$s</string>
    <string name="program_off_air_until">Off air until %1$s</string>
    <!-- A station break (leftover time spread through the day): the time is when the next programme starts. -->
    <string name="program_station_break_up_next">Station break · Up next at %1$s</string>
    <string name="program_starts_in">Starts in %1$d min</string>
    <string name="program_minutes_left">%1$d min left</string>

    <!-- The info overlay's detail line (year, genres, runtime) and its loading indicator's description. -->
    <string name="program_runtime_minutes">%1$d min</string>
    <string name="program_details_loading">Loading details</string>
    <!-- The overlay's last line: it holds no focus, so this is how the viewer learns to close it. -->
    <string name="program_back_to_close">Back to close</string>

    <!-- The notice that a channel the viewer switched on is ready (#776): its number and name, or how many. -->
    <string name="ready_notice_one">%1$d %2$s is on the air</string>
    <plurals name="ready_notice_many">
        <item quantity="one">%1$d channel is on the air</item>
        <item quantity="other">%1$d channels are on the air</item>
    </plurals>

    <!-- What a channel holds (#757): the box beside the guide's channel and the properties sheet's "What it holds". -->
    <plurals name="holdings_hours">
        <item quantity="one">%1$d hour of programmes</item>
        <item quantity="other">%1$d hours of programmes</item>
    </plurals>
    <string name="holdings_days">about %1$d days</string>
    <plurals name="holdings_titles">
        <item quantity="one">%1$d title</item>
        <item quantity="other">%1$d titles</item>
    </plurals>
    <!-- The hours line: the hours, then (from two days up) the days in brackets, then the titles. -->
    <string name="holdings_line">%1$s · %2$s</string>
    <string name="holdings_line_days">%1$s (%2$s) · %3$s</string>
    <string name="holdings_home_to">Home to:</string>
    <string name="holdings_mostly">Mostly:</string>
    <string name="holdings_more">+ %1$d more</string>
    <!-- Who a channel is (#777): the properties sheet and the guide's channel box both use these, so they word a
         channel one way. The tags: the kind, and the kids tag with the channel's rating ceiling when it has one. -->
    <string name="channel_tag_builtin">Built-in</string>
    <string name="channel_tag_custom">Custom</string>
    <string name="channel_tag_leftovers">Leftovers</string>
    <string name="channel_tag_kids">Kids \u00B7 up to %1$s</string>
    <string name="channel_tag_kids_plain">Kids</string>
    <!-- What a channel plays: the sheet's "What it plays" rows, and the box's tag line for a channel with no
         personality (its first row, as "Label: values"). -->
    <string name="channel_plays_leftovers">Plays whatever nothing else does</string>
    <string name="channel_plays_line">%1$s: %2$s</string>
    <string name="channel_plays_join">%1$s, %2$s</string>
    <string name="channel_plays_genres">Genres</string>
    <string name="channel_plays_tags">Tags</string>
    <string name="channel_plays_years">Years</string>
    <string name="channel_plays_studios">Studios</string>
    <string name="channel_plays_collections">Collections</string>
    <string name="channel_plays_shows">Shows</string>
    <string name="channel_plays_titles">Titles</string>
    <string name="channel_plays_libraries">Libraries</string>
    <string name="channel_plays_always">Always</string>
    <string name="channel_plays_never">Never</string>
    <string name="channel_plays_years_range">%1$d to %2$d</string>
    <string name="channel_plays_never_rating">Anything rated above %1$s</string>

    <!-- The opening screen: the name, which is all a screen reader says, and the tagline drawn under it. -->
    <string name="stan_opening_announcement">Station Break</string>
    <string name="stan_opening_tagline">Put your feet up</string>

    <!-- The guide family's hint rows (DESIGN.md "Key Hints"): a key cap's words, then what the key does. The arrows'
         cap is read out in words. -->
    <string name="hint_key_ok">OK</string>
    <string name="hint_key_back">Back</string>
    <string name="hint_key_left_right">◂ ▸</string>
    <string name="hint_key_left_right_spoken">Left or right</string>
    <string name="hint_choose">Choose</string>
    <string name="hint_close">Close</string>
</resources>

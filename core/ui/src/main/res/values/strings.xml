<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-or-later WITH AdditionRef-StationBreak-AppStore

  The program text shared by the live banner and the guide (spec 17): episode lines, next/off-air/countdown words and
  the program info overlay.
-->
<resources>
    <!-- The episode line: season and episode numbers (the ones that are known), then the episode's title. -->
    <string name="program_episode_both">S%1$d E%2$d · %3$s</string>
    <string name="program_episode_season">S%1$d · %2$s</string>
    <string name="program_episode_number">E%1$d · %2$s</string>

    <string name="program_next">Next: %1$s at %2$s</string>
    <string name="program_off_air_until">Off air until %1$s</string>
    <!-- A station break (leftover time spread through the day): the time is when the next programme starts. -->
    <string name="program_station_break_up_next">Station break · Up next at %1$s</string>
    <string name="program_starts_in">Starts in %1$d min</string>
    <string name="program_minutes_left">%1$d min left</string>

    <!-- The info overlay's detail line (year, genres, runtime) and its loading indicator's description. -->
    <string name="program_runtime_minutes">%1$d min</string>
    <string name="program_details_loading">Loading details</string>
    <!-- The overlay's last line: it holds no focus, so this is how the viewer learns to close it. -->
    <string name="program_back_to_close">Back to close</string>

    <!-- What a channel holds (#757): the box beside the guide's channel and the properties sheet's "What it holds". -->
    <plurals name="holdings_hours">
        <item quantity="one">%1$d hour of programmes</item>
        <item quantity="other">%1$d hours of programmes</item>
    </plurals>
    <string name="holdings_days">about %1$d days</string>
    <plurals name="holdings_titles">
        <item quantity="one">%1$d title</item>
        <item quantity="other">%1$d titles</item>
    </plurals>
    <!-- The hours line: the hours, then (from two days up) the days in brackets, then the titles. -->
    <string name="holdings_line">%1$s · %2$s</string>
    <string name="holdings_line_days">%1$s (%2$s) · %3$s</string>
    <string name="holdings_home_to">Home to:</string>
    <string name="holdings_mostly">Mostly:</string>
    <string name="holdings_more">+ %1$d more</string>
</resources>
